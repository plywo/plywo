RAILS_ENV=production
PLYWO_RUNTIME_ROLE=control_plane
DATABASE_URL=postgres://USER:PASSWORD@DB_HOST:5432/plywo_control_plane

PLYWO_PUBLIC_URL=https://app.plywo.com
PLYWO_GITHUB_APP_SLUG=plywo
PLYWO_GITHUB_APP_ID=
PLYWO_GITHUB_CLIENT_ID=
PLYWO_GITHUB_WEBHOOK_SECRET=
PLYWO_GITHUB_PRIVATE_KEY_PATH=/run/secrets/plywo-github-private-key.pem
PLYWO_GITHUB_APP_CHECK_NAME=Plywo / Behavioral Diff
PLYWO_GITHUB_APP_BOT_LOGIN=plywo[bot]

PLYWO_EXECUTOR=remote
PLYWO_REMOTE_EXECUTOR_URL=https://executor.plywo.com
PLYWO_REMOTE_EXECUTOR_TOKEN=
PLYWO_REMOTE_EXECUTOR_OPEN_TIMEOUT_SECONDS=5
PLYWO_REMOTE_EXECUTOR_READ_TIMEOUT_SECONDS=2100

PLYWO_EXECUTION_LEASE_SECONDS=1800
PLYWO_EXECUTION_HEARTBEAT_INTERVAL_SECONDS=600
