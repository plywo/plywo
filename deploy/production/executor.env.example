RAILS_ENV=production
PLYWO_RUNTIME_ROLE=executor_service
DATABASE_URL=postgres://plywo:CHANGE_ME@postgres:5432/plywo_executor

PLYWO_EXECUTOR_SERVICE_TOKEN=
PLYWO_EXECUTOR_SERVICE_ADAPTER=git_clone
PLYWO_EXECUTOR_SERVICE_REQUEST_LEASE_SECONDS=2400

# PostgreSQL authority used for disposable customer subject databases.
PLYWO_LOCAL_POSTGRES_URL=postgres://plywo:CHANGE_ME@postgres:5432

# These must remain unset on the executor:
# PLYWO_GITHUB_PRIVATE_KEY_PATH
# PLYWO_GITHUB_WEBHOOK_SECRET
# PLYWO_REMOTE_EXECUTOR_URL
# PLYWO_REMOTE_EXECUTOR_TOKEN
# PLYWO_EXECUTOR=remote
