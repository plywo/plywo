#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

log() { printf '\n==> %s\n' "$*"; }
warn() { printf '\nWARNING: %s\n' "$*" >&2; }
die() { printf '\nERROR: %s\n' "$*" >&2; exit 1; }

normalize_environment() {
  case "${1:-development}" in
    development|dev) printf 'development' ;;
    staging|stage|stg) printf 'staging' ;;
    production|prod) printf 'production' ;;
    *) die "Unknown environment: ${1}" ;;
  esac
}

ENVIRONMENT="$(normalize_environment "${1:-development}")"
OWNER="${PLYWO_GITHUB_APP_OWNER:-plywo}"

case "$ENVIRONMENT" in
  development)
    APP_NAME="Plywo Development"
    APP_SLUG="plywo-development"
    DEFAULT_KEY_SOURCE="${HOME}/Downloads/plywo-development.pem"
    DEFAULT_PUBLIC_URL="https://github-dev.flowato.dev"
    ;;
  staging)
    APP_NAME="Plywo Staging"
    APP_SLUG="plywo-staging"
    DEFAULT_KEY_SOURCE="${HOME}/Downloads/plywo-staging.pem"
    DEFAULT_PUBLIC_URL="https://github-staging.flowato.dev"
    ;;
  production)
    APP_NAME="Plywo"
    APP_SLUG="plywo"
    DEFAULT_KEY_SOURCE="${HOME}/Downloads/plywo.pem"
    DEFAULT_PUBLIC_URL="https://github.flowato.dev"
    ;;
esac

KEY_SOURCE="${2:-$DEFAULT_KEY_SOURCE}"
CREDENTIAL_DIR="tmp/github-app"
ENV_FILE="${CREDENTIAL_DIR}/${ENVIRONMENT}.env"
KEY_DEST="${CREDENTIAL_DIR}/plywo-${ENVIRONMENT}.pem"
SETTINGS_URL="https://github.com/organizations/${OWNER}/settings/apps/${APP_SLUG}"
PUBLIC_URL="${PLYWO_PUBLIC_URL:-$DEFAULT_PUBLIC_URL}"

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

validate_private_key() {
  [[ -f "$KEY_SOURCE" ]] || die "Private key not found: ${KEY_SOURCE}"
  openssl pkey -in "$KEY_SOURCE" -check -noout >/dev/null 2>&1 || die "Invalid private key: ${KEY_SOURCE}"
}

load_existing_identity() {
  if [[ -f "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE"
  fi

  [[ -n "${PLYWO_GITHUB_APP_ID:-}" ]] || die "PLYWO_GITHUB_APP_ID is missing. Expected it in ${ENV_FILE}."
  [[ -n "${PLYWO_GITHUB_CLIENT_ID:-}" ]] || die "PLYWO_GITHUB_CLIENT_ID is missing. Expected it in ${ENV_FILE}."
}

install_private_key() {
  mkdir -p "$CREDENTIAL_DIR"
  umask 077
  install -m 600 "$KEY_SOURCE" "$KEY_DEST"
  log "Installed new private key -> ${KEY_DEST}"
}

generate_webhook_secret() {
  PLYWO_GITHUB_WEBHOOK_SECRET="$(openssl rand -hex 32)"
  export PLYWO_GITHUB_WEBHOOK_SECRET

  if command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$PLYWO_GITHUB_WEBHOOK_SECRET" | pbcopy
    log "Generated a fresh webhook secret and copied it to the clipboard"
  else
    warn "pbcopy is unavailable. Set PLYWO_GITHUB_WEBHOOK_SECRET manually before rerunning."
    return 1
  fi
}

write_environment_file() {
  local tmp_file="${ENV_FILE}.tmp.$$"
  umask 077

  cat >"$tmp_file" <<EOF
export PLYWO_GITHUB_APP_ID=${PLYWO_GITHUB_APP_ID}
export PLYWO_GITHUB_CLIENT_ID=${PLYWO_GITHUB_CLIENT_ID}
export PLYWO_GITHUB_WEBHOOK_SECRET=${PLYWO_GITHUB_WEBHOOK_SECRET}
export PLYWO_GITHUB_PRIVATE_KEY_PATH=${KEY_DEST}
EOF

  chmod 600 "$tmp_file"
  mv "$tmp_file" "$ENV_FILE"
  log "Updated local credential environment -> ${ENV_FILE}"
}

open_github_settings() {
  if command -v open >/dev/null 2>&1 && [[ "${NO_OPEN:-0}" != "1" ]]; then
    open "$SETTINGS_URL"
  fi

  printf '\nGitHub App settings:\n%s\n' "$SETTINGS_URL"
  printf '\nThe new webhook secret is in your clipboard.\n'
  printf 'In GitHub: Webhook -> Change secret -> paste -> Save changes.\n'
  printf 'Do not paste the secret or PEM into chat.\n\n'

  if [[ -t 0 ]]; then
    read -r -p 'Press Enter after GitHub has saved the new webhook secret... ' _
  else
    die "Interactive confirmation is required after changing the webhook secret in GitHub"
  fi
}

ensure_port_available() {
  local port="${PORT:-3000}"
  if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    warn "Port ${port} is already in use. Stop the previous Plywo setup process with Ctrl-C."
    if [[ -t 0 ]]; then
      read -r -p 'Press Enter after the port is free... ' _
    fi
  fi

  if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    die "Port ${port} is still in use"
  fi
}

run_setup() {
  if [[ -t 0 ]]; then
    printf '\nPublic URL [%s]: ' "$PUBLIC_URL"
    read -r entered_url
    PUBLIC_URL="${entered_url:-$PUBLIC_URL}"
  fi

  [[ "$PUBLIC_URL" == https://* ]] || die "Public URL must use https://"

  ensure_port_available
  log "Starting ${APP_NAME} with external Cloudflare tunnel"

  export PLYWO_TUNNEL_MODE=external
  export PLYWO_PUBLIC_URL="$PUBLIC_URL"
  export PLYWO_GITHUB_APP_MANIFEST_ENV="$ENVIRONMENT"
  export PLYWO_GITHUB_PRIVATE_KEY_PATH="$KEY_DEST"

  exec bin/setup-github-app "$ENVIRONMENT"
}

main() {
  require_command openssl
  [[ -x bin/setup-github-app ]] || die "bin/setup-github-app is missing or not executable"

  log "Rotating ${APP_NAME} credentials"
  printf 'Private key source: %s\n' "$KEY_SOURCE"

  validate_private_key
  load_existing_identity
  install_private_key
  generate_webhook_secret
  write_environment_file
  open_github_settings
  run_setup
}

main "$@"
